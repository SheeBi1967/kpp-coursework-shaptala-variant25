<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <servlet>
        <servlet-name>AuthorServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.AuthorServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthorServlet</servlet-name>
        <url-pattern>/authors</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ReviewerServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.ReviewerServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReviewerServlet</servlet-name>
        <url-pattern>/reviewers</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DocumentServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.DocumentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DocumentServlet</servlet-name>
        <url-pattern>/documents</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ApprovalRequestServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.ApprovalRequestServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApprovalRequestServlet</servlet-name>
        <url-pattern>/requests</url-pattern>
    </servlet-mapping>

</web-app>
